# Environment Variables for Agro Predict Wise

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api
VITE_API_TIMEOUT=10000

# External API Keys (Optional - for real integrations)
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here
VITE_MAPBOX_API_KEY=your_mapbox_api_key_here

# Feature Flags
VITE_ENABLE_MOCK_DATA=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_ANALYTICS=false

# App Configuration
VITE_APP_NAME="Agro Predict Wise"
VITE_APP_VERSION=1.0.0
VITE_SUPPORT_EMAIL=support@agropredictwise.com

# External Services
VITE_ZAPIER_WEBHOOK_URL=your_zapier_webhook_url_here
VITE_ENABLE_WEBHOOKS=false

# Development Settings
VITE_DEBUG_MODE=true
VITE_LOG_LEVEL=debug

# Production Settings (for .env.production)
# VITE_API_BASE_URL=https://api.agropredictwise.com/api
# VITE_DEBUG_MODE=false
# VITE_LOG_LEVEL=error
# VITE_ENABLE_MOCK_DATA=false